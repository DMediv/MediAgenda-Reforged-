<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No disponible: sin sombra, fondo gris claro -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo" />
            <stroke android:width="2dp" android:color="@color/gris_inactivo" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/azul_primario" />
                    <stroke android:width="2dp" android:color="@color/negro" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:left="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/negro" />
                </shape>
            </item>
            <item android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/azul_primario" />
                    <stroke android:width="2dp" android:color="@color/negro" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>