<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.DetalleCitaMedicoActivity">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_barra_superior"
        android:background="@color/azul_primario"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_regresar"
            android:src="@drawable/ic_regresar"
            app:tint="@color/blanco" />

        <TextView
            style="@style/Texto.TituloBarra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/detalle_titulo"
            android:textColor="@color/blanco" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrContenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen_pantalla">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/relleno_tarjeta">

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_paciente" />
                    <TextView
                        android:id="@+id/txtPaciente"
                        style="@style/Texto.Cuerpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Juan Pérez López" />

                    <View style="@style/Divisor"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_fecha" />
                    <TextView
                        android:id="@+id/txtFecha"
                        style="@style/Texto.Cuerpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="jueves 26 de noviembre de 2026" />

                    <View style="@style/Divisor"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_hora" />
                    <TextView
                        android:id="@+id/txtHora"
                        style="@style/Texto.Cuerpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="11:45 – 12:15" />

                    <View style="@style/Divisor"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_consultorio" />
                    <TextView
                        android:id="@+id/txtConsultorio"
                        style="@style/Texto.Cuerpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Consultorio 3" />
                    <TextView
                        android:id="@+id/txtUbicacion"
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Planta baja, ala norte" />

                    <View style="@style/Divisor"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_estado" />
                    <TextView
                        android:id="@+id/txtEstado"
                        style="@style/EtiquetaEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="Programada" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtVerPaciente"
                    style="@style/Texto.Enlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/detalle_ver_paciente" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_campos"
                    android:background="@drawable/aviso_info"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/icono"
                        android:layout_height="@dimen/icono"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/azul_primario" />

                    <TextView
                        style="@style/Texto.Cuerpo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detalle_aviso" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/prgCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/navegacion_medico" />
</LinearLayout>