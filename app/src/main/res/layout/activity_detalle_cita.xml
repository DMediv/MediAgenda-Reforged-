<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/fondo">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:background="@color/azul_primario">
        <TextView android:layout_width="28dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="@color/blanco"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detalle de cita" android:textSize="20sp" android:textColor="@color/blanco" android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_tarjeta">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="42dp" android:layout_height="56dp" android:gravity="center" android:orientation="vertical" android:background="@color/azul_primario">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 nov" android:textSize="11sp" android:textColor="@color/blanco" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:30 – 11:00" android:textSize="16sp" android:textColor="@color/negro" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="jue 12 nov 2026" android:textSize="14sp" android:textColor="@color/negro"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/bg_chip_azul" android:text="Programada" android:textSize="12sp" android:textColor="@color/negro"/>
                    </LinearLayout>
                    <TextView android:layout_width="24dp" android:layout_height="48dp" android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="@color/negro"/>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_tarjeta">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Médico" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. Alejandro Ramírez Fuentes" android:textSize="14sp" android:textColor="@color/negro"/>
                <View android:layout_width="match_parent" android:layout_height="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Especialidad" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medicina interna" android:textSize="14sp" android:textColor="@color/negro"/>
                <View android:layout_width="match_parent" android:layout_height="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Consultorio" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Consultorio 2" android:textSize="14sp" android:textColor="@color/negro"/>
                <View android:layout_width="match_parent" android:layout_height="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estado" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Programada" android:textSize="14sp" android:textColor="@color/negro"/>
                <View android:layout_width="match_parent" android:layout_height="8dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_aviso_azul">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ⓘ Reprogramar: una sola vez y hasta 24 h antes de la cita." android:textSize="12sp" android:textColor="@color/negro"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancelar: hasta 3 h antes de la cita." android:textSize="12sp" android:textColor="@color/negro"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="20dp"/>
            <Button android:id="@+id/btnReprogramar" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_boton_principal" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:text="▣ Reprogramar cita" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="16sp" android:textStyle="bold"/>
            <View android:layout_width="match_parent" android:layout_height="8dp"/>
            <Button android:id="@+id/btnCancelarCita" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_boton_rojo" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:text="Cancelar cita" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:background="@color/blanco">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="28dp" android:text="⌂" android:textSize="20sp" android:textColor="@color/texto_secundario"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inicio" android:textSize="10sp" android:textColor="@color/texto_secundario"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="28dp" android:text="▣" android:textSize="20sp" android:textColor="@color/azul_navegacion"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mis citas" android:textSize="10sp" android:textColor="@color/azul_navegacion"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="28dp" android:text="+" android:textSize="20sp" android:textColor="@color/texto_secundario"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agendar" android:textSize="10sp" android:textColor="@color/texto_secundario"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="28dp" android:text="☷" android:textSize="20sp" android:textColor="@color/texto_secundario"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Historial" android:textSize="10sp" android:textColor="@color/texto_secundario"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="28dp" android:text="♙" android:textSize="20sp" android:textColor="@color/texto_secundario"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perfil" android:textSize="10sp" android:textColor="@color/texto_secundario"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>