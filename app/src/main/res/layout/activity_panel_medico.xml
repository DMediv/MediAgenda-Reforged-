<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.PanelMedicoActivity">

    <include layout="@layout/barra_panel" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen_pantalla">

                <TextView
                    android:id="@+id/txtNombreMedico"
                    style="@style/Texto.TituloPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Dr. Luis Hernández" />

                <TextView
                    android:id="@+id/txtEspecialidad"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="Medicina interna · Consultorio 3" />


                <TextView
                    style="@style/Texto.Encabezado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_secciones"
                    android:text="@string/panel_resumen_hoy" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_lista"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/separacion_lista"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_margin="2dp"
                            android:background="@color/estado_programada" />

                        <TextView
                            android:id="@+id/txtProgramadas"
                            style="@style/Texto.TituloPanel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/relleno_tarjeta"
                            android:paddingTop="4dp"
                            android:text="0" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/relleno_tarjeta"
                            android:paddingBottom="@dimen/relleno_tarjeta"
                            android:text="@string/panel_programadas" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_margin="2dp"
                            android:background="@color/estado_atendida" />

                        <TextView
                            android:id="@+id/txtAtendidas"
                            style="@style/Texto.TituloPanel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/relleno_tarjeta"
                            android:paddingTop="4dp"
                            android:text="0" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/relleno_tarjeta"
                            android:paddingBottom="@dimen/relleno_tarjeta"
                            android:text="@string/panel_atendidas" />
                    </LinearLayout>
                </LinearLayout>


                <TextView
                    style="@style/Texto.Encabezado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_secciones"
                    android:text="@string/panel_siguiente_cita" />

                <include
                    android:id="@+id/lytSiguienteCita"
                    layout="@layout/tarjeta_cita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_lista"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtSinCitas"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_lista"
                    android:text="@string/panel_sin_citas"
                    android:visibility="gone" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_secciones"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/lytAccesoAgenda"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/separacion_lista"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta">

                        <ImageView
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_agenda"
                            app:tint="@color/azul_primario" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/panel_agenda" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lytAccesoPacientes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta">

                        <ImageView
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pacientes"
                            app:tint="@color/azul_primario" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/panel_mis_pacientes" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/prgCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/navegacion_medico" />
</LinearLayout>