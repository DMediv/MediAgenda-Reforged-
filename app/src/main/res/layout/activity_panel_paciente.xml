<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.PanelPacienteActivity">

    <include layout="@layout/barra_panel" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen_pantalla">


                <TextView
                    android:id="@+id/txtSaludo"
                    style="@style/Texto.TituloPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Hola, Juan" />

                <TextView
                    style="@style/Texto.Encabezado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_secciones"
                    android:text="@string/panel_proxima_cita" />

                <include
                    android:id="@+id/lytProximaCita"
                    layout="@layout/tarjeta_cita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_lista"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtSinCitas"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_lista"
                    android:text="@string/panel_sin_citas"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_secciones"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/lytAccesoInfo"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alto_acceso"
                        android:layout_marginEnd="@dimen/separacion_lista"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta">

                        <ImageView
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_perfil"
                            app:tint="@color/azul_primario" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/panel_info_personal"
                            android:maxLines="2"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lytAccesoMisCitas"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alto_acceso"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta"
                        android:maxLines="2">

                        <ImageView
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_mis_citas"
                            app:tint="@color/azul_primario" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/nav_mis_citas" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_lista"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/lytAccesoAgendar"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alto_acceso"
                        android:layout_marginEnd="@dimen/separacion_lista"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta"
                        android:maxLines="2">

                        <ImageView
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_agendar"
                            app:tint="@color/azul_primario" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/panel_agendar_cita" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lytAccesoHistorial"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alto_acceso"
                        android:layout_weight="1"
                        android:background="@drawable/tarjeta"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta">

                        <ImageView
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_historial"
                            app:tint="@color/azul_primario" />

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/panel_historial_citas"
                            android:maxLines="2"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/prgCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/navegacion_paciente" />
</LinearLayout>