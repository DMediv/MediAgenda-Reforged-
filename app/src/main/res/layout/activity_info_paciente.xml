<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.InfoPacienteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_barra_superior"
        android:background="@color/azul_primario"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_regresar"
            android:src="@drawable/ic_regresar"
            app:tint="@color/blanco" />

        <TextView
            style="@style/Texto.TituloBarra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/info_titulo"
            android:textColor="@color/blanco" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrContenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen_pantalla">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtIniciales"
                        style="@style/Texto.TituloBarra"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/circulo_avatar"
                        android:gravity="center"
                        tools:text="JP" />

                    <TextView
                        android:id="@+id/txtNombre"
                        style="@style/Texto.TituloBarra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/separacion_campos"
                        android:layout_weight="1"
                        tools:text="Juan Pérez Martínez" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_secciones"
                    android:background="@drawable/tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/relleno_tarjeta">

                    <TextView
                        style="@style/Texto.Encabezado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/info_datos_personales"
                        android:textColor="@color/azul_primario" />

                    <LinearLayout
                        android:id="@+id/lytDatosPersonales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytTarjetaHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_lista"
                    android:background="@drawable/tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/relleno_tarjeta"
                    android:visibility="gone">

                    <TextView
                        style="@style/Texto.Encabezado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/info_historial_medico"
                        android:textColor="@color/azul_primario" />

                    <LinearLayout
                        android:id="@+id/lytHistorial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVerHistorial"
                    style="@style/Boton.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_boton"
                    android:layout_marginTop="@dimen/separacion_secciones"
                    android:text="@string/info_ver_historial" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/prgCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/navegacion_medico" />
</LinearLayout>