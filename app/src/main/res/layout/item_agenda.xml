<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/vDivisor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divisor" />

    <LinearLayout
        android:id="@+id/lytFilaCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/txtAgendaHora"
            style="@style/Texto.Encabezado"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            tools:text="10:30" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAgendaPaciente"
                style="@style/Texto.Cuerpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Juan Pérez Martínez" />

            <TextView
                android:id="@+id/txtAgendaEstado"
                style="@style/EtiquetaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Programada" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icono"
            android:layout_height="@dimen/icono"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_siguiente"
            app:tint="@color/texto_secundario" />
    </LinearLayout>
</LinearLayout>