<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#80000000">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:background="@color/azul_primario">
            <TextView android:layout_width="28dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="@color/blanco"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detalle de cita" android:textSize="20sp" android:textColor="@color/blanco" android:textStyle="bold"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#66000000"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="20dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_tarjeta">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠ ¿Cancelar esta cita?" android:textSize="18sp" android:textColor="@color/negro" android:textStyle="bold"/>
        <View android:layout_width="match_parent" android:layout_height="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="jue 12 nov, 10:30" android:textSize="14sp" android:textColor="@color/negro"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. Alejandro Ramírez Fuentes" android:textSize="14sp" android:textColor="@color/texto_secundario"/>
        <View android:layout_width="match_parent" android:layout_height="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Esta acción no se puede deshacer. El horario volverá a quedar disponible." android:textSize="14sp" android:textColor="@color/negro"/>
        <View android:layout_width="match_parent" android:layout_height="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingEnd="5dp">
                <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_boton_secundario" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:text="No, volver" android:textAllCaps="false" android:textColor="@color/azul_primario" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="5dp">
                <Button android:id="@+id/btnConfirmarCancelar" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_boton_rojo" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:text="Sí, cancelar" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>