<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Texto">
        <item name="android:textColor">@color/negro</item>
    </style>

    <style name="Texto.TituloPanel">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Texto.TituloBarra">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Texto.Encabezado">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Texto.Cuerpo">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="Texto.Etiqueta">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/azul_primario</item>
    </style>

    <style name="Texto.Secundario">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.Nota">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Texto.Error">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/rojo_alerta</item>
    </style>
</resources>